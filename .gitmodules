[submodule "addons/limbo_console"]
	path = addons/limbo_console
	url = https://github.com/limbonaut/limbo_console.git
	# Godot regenerates the addon's *.import cache files on editor open;
	# they're tracked upstream but we don't want them as noise. `dirty`
	# silences working-tree modifications while still flagging actual
	# pin bumps (changes to the submodule's commit pointer).
	ignore = dirty
