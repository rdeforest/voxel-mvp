<mxfile host="app.diagrams.net" type="device">
  <diagram name="System data-flow" id="sysflow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- PBD group background (drawn first so it sits behind its nodes) -->
        <mxCell id="pbdgrp" value="PBD — authoritative structural sim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="160" width="300" height="300" as="geometry" />
        </mxCell>

        <!-- Input / actions -->
        <mxCell id="play" value="Player movement + edits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="-230" y="170" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="click" value="Player click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="40" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="factory" value="ActionFactories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="action" value="Action — validate / execute&#10;(Dig · Fill · Flatten · Construction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Event bus (hub) -->
        <mxCell id="bus" value="VoxelEventBus&#10;(spatial pub/sub)" style="shape=stadium;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Tracking spine -->
        <mxCell id="ts" value="TerrainSupport&#10;tracked cells · anchors · suspended-mass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="370" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ps" value="PartSupport&#10;part_registry (placed parts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="460" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- PBD nodes -->
        <mxCell id="pbd" value="PbdStructure&#10;rebuild on edit · step per tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="360" y="195" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="builder" value="PbdNetworkBuilder&#10;cells → nodes (mass=density),&#10;members (weakest-link), anchors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="360" y="270" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sim" value="PbdSim (C++ XPBD)&#10;substepped solve → axial force&#10;fatigue/creep → breakage · sleeping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="360" y="360" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- Collapse / falling -->
        <mxCell id="detach" value="Detachment" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="700" y="365" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="carve" value="FallingBodyFactory&#10;+ carve SDF to air" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="660" y="480" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dropp" value="PartSupport.collapse_part&#10;→ RigidBody3D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="900" y="480" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="body" value="Falling RigidBody3D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="790" y="580" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ftick" value="_tick_falling_bodies&#10;buried → reintegrate · free → physics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="760" y="650" width="260" height="50" as="geometry" />
