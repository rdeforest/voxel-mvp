        <!-- Terrain + render -->
        <mxCell id="terrain" value="VoxelLodTerrain (SDF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="360" y="500" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vis" value="DCOctreeMesher&#10;visual (crack-free LOD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="580" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col" value="VoxelMesherDC&#10;per-block collision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- World-ready gate -->
        <mxCell id="gate" value="world.gd · world-ready gate&#10;is_area_editable around player" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="-240" y="280" width="200" height="60" as="geometry" />
