        <mxCell id="e9" value="tracked cells + anchors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="ts" target="builder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="part cells" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="ps" target="builder"><mxGeometry relative="1" as="geometry" /></mxCell>

