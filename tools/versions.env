# Pinned engine + module refs. This file is the single source of truth.
# Changing a pin here, committing, and re-running tools/build on each machine
# is the entire "update the engine" ritual.
#
# GODOT_REF / GODOT_VOXEL_REF may be tags or commit hashes. Commit hashes are
# preferred for maximum reproducibility (tags can theoretically be re-pointed).
#
# 89cea1439 is confirmed == the 4.6-stable tag, and is the exact Godot commit
# Zylann built godot_voxel v1.6 against. Matching it eliminates the
# "untested engine/module pairing" variable.

GODOT_REF=89cea1439
GODOT_VOXEL_REF=v1.6

# Extra SCons arguments applied to every build, on every platform.
# precision=double is the one non-retrofittable architectural decision in the
# roadmap (planet-scale coordinate precision). It must be here.
SCONS_EXTRA_ARGS="precision=double"

# Where the upstream repos live, relative to this project's root.
# Both are plain upstream clones (no forks — YAGNI).
GODOT_DIR_REL="../../godotengine/godot"
GODOT_VOXEL_DIR_REL="../../Zylann/godot_voxel"
